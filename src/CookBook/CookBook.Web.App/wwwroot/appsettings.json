{
  "ApiOptions": {
    "BaseUrl": "https://app-iw5-api.azurewebsites.net/"
  },
  "LocalDbOptions": {
    "IsEnabled": true
  },
  "IdentityOptions": {
    "IsEnabled": false
  },
  "WebAuthenticationOptions": {
    "SelectedProvider": "CookBookIdentityProvider",
    "Providers": [
      {
        "ProviderType": "CookBookIdentityProvider",
        "IsEnabled": true,
        "Authority": "https://app-iw5-identity.azurewebsites.net",
        "ClientId": "cookbookclient",
        "ResponseType": "code",
        "RedirectUri": "https://app-iw5-web.azurewebsites.net/authentication/login-callback",
        "PostLogoutRedirectUri": "https://app-iw5-web.azurewebsites.net/",
        "DefaultScopes": [ "openid", "profile", "cookbookapi" ],
        "UpstreamLogoutIsEnabled": true
      },
      {
        "ProviderType": "Entra",
        "IsEnabled": false,
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ClientId": "<web-spa-client-id>",
        "ResponseType": "code",
        "RedirectUri": "https://app-iw5-web.azurewebsites.net/authentication/login-callback",
        "PostLogoutRedirectUri": "https://app-iw5-web.azurewebsites.net/",
        "DefaultScopes": [ "openid", "profile", "api://<api-client-id>/access_as_user" ],
        "UpstreamLogoutIsEnabled": true
      }
    ]
  }
}