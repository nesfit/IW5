@using CookBook.Common.Options
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.Extensions.Options
@inject NavigationManager Navigation
@inject IOptions<IdentityOptions> IdentityOptions
@inject IOptions<WebAuthenticationOptions> WebAuthenticationOptions
@inject SignOutSessionStateManager SignOutManager

@if (IdentityOptions.Value.IsEnabled)
{
	<AuthorizeView>
		<Authorized>
			<div class="nav-link font-weight-bold">
				Hello @context.User.FindFirst("sub")?.Value!

				<button class="nav-link btn btn-link" @onclick="BeginLogOut">Log out</button>
			</div>
		</Authorized>

		<NotAuthorized>
			<a href="authentication/login" class="nav-link font-weight-bold">Log in</a>
		</NotAuthorized>
	</AuthorizeView>
}

@code{
    private async Task BeginLogOut()
    {
        var provider = WebAuthenticationOptions.Value.Providers.FirstOrDefault(candidate =>
            candidate.IsEnabled
            && candidate.ProviderType == WebAuthenticationOptions.Value.SelectedProvider);

        if (provider?.UpstreamLogoutIsEnabled == false)
        {
            await SignOutManager.SetSignOutState();
            Navigation.NavigateTo("authentication/logout-callback");
            return;
        }

        Navigation.NavigateToLogout("authentication/logout?logoutUrl=");
    }
}   