{
  "AllowedHosts": "*",
  "ServerName:Name": "",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DALSelectionOptions": {
    "Type": "Memory"
  },
  "IdentityOptions": {
    "IsEnabled": false
  },
  "TrustedIssuersOptions": {
    "Issuers": [
      {
        "Scheme": "CookBookIdentityProvider",
        "ProviderType": "CookBookIdentityProvider",
        "Authority": "https://app-iw5-identity.azurewebsites.net",
        "ValidIssuers": [ "https://app-iw5-identity.azurewebsites.net" ],
        "ValidAudiences": [ "cookbookclientaudience" ],
        "NameClaimType": "sub",
        "RoleClaimType": "role"
      },
      {
        "Scheme": "Entra",
        "ProviderType": "Entra",
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ValidIssuers": [ "https://login.microsoftonline.com/<tenant-id>/v2.0" ],
        "ValidAudiences": [ "<api-client-id>" ],
        "NameClaimType": "oid",
        "RoleClaimType": "roles"
      }
    ]
  }
}
