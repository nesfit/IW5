{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ContentSecurityPolicy": {
    "ClientOrigin": "https://localhost:44355"
  },
  "CookBookIdentityProviderOptions": {
    "Local": {
      "IsEnabled": true
    },
    "ExternalProviders": [
      {
        "Scheme": "Entra",
        "DisplayName": "Microsoft Entra ID",
        "ProviderType": "Entra",
        "IsEnabled": false,
        "Authority": "https://login.microsoftonline.com/TENANT_ID/v2.0",
        "ClientId": "IDP_CLIENT_ID",
        "ClientSecret": "",
        "CallbackPath": "/signin-entra",
        "SignedOutCallbackPath": "/signout-callback-entra",
        "UpstreamLogoutIsEnabled": true,
        "SubjectClaimType": "oid",
        "TenantClaimType": "tid",
        "EmailClaimType": "email",
        "EmailVerifiedClaimType": "email_verified",
        "RoleClaimType": "roles"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}